            "pages": [
              "guides/auth-security"
            ]
          },
          {
            "group": "Padrões de Comunicação (Erros, Paginação e Rate Limit)",
            "pages": [
              "guides/communication-standards",
              "websockets"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "guides/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "Referência da API",
        "groups": [
          {
            "group": "Visão Geral da API",
            "pages": [
              "api-reference/index"
            ]
          },
          {
            "group": "Autenticação & Contas",
            "pages": [
