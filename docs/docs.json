            "pages": [
              "api-reference/reports/create",
              "api-reference/feedbacks/create"
            ]
          },
          {
            "group": "Painel Administrativo",
            "pages": [
              "api-reference/admin/auth",
              "api-reference/admin/stats",
              "api-reference/admin/users",
              "api-reference/admin/update-user-status",
              "api-reference/admin/rooms",
              "api-reference/admin/delete-room",
